diff --git a/tests/institution-separation.test.mjs b/tests/institution-separation.test.mjs
new file mode 100644
index 0000000..8eeed7d
--- /dev/null
+++ b/tests/institution-separation.test.mjs
@@ -0,0 +1,48 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+
+const read = (path) => readFileSync(path, "utf8");
+
+test("package and document identity belong to X Money only", () => {
+  const pkg = JSON.parse(read("package.json"));
+  const html = read("index.html");
+  const readme = read("README.md");
+  assert.equal(pkg.name, "vantoris-x-money");
+  assert.match(html, /<title>Vantoris X Money<\/title>/);
+  assert.doesNotMatch(html, /Vantoris Private Institution|Ashcombe|American Vanguard/);
+  assert.match(readme, /^# Vantoris X Money/);
+  assert.match(readme, /not Ashcombe Private Bank/);
+});
+
+test("member brand does not adopt another institution", () => {
+  const landing = read("src/pages/Landing.jsx");
+  const logo = read("src/components/vantoris/brand/VantorisLogo.jsx");
+  const sidebar = read("src/components/vantoris/MemberSidebar.jsx");
+  assert.match(landing, /Vantoris X Money/);
+  assert.doesNotMatch(landing, /Ashcombe|American Vanguard|Vantoris Private Institution/);
+  assert.match(logo, /X&nbsp;MONEY/);
+  assert.doesNotMatch(logo, /PRIVATE&nbsp;INSTITUTION/);
+  assert.match(sidebar, /Vantoris X Money/);
+});
+
+test("Hambros tribute and founder stories are not institutional records", () => {
+  const tribute = read("src/components/vantoris/HambrosTribute.jsx");
+  const stories = read("src/components/vantoris/FounderStories.jsx");
+  assert.match(tribute, /makes no claim of succession, ownership, partnership, endorsement or affiliation/);
+  assert.match(tribute, /not a Vantoris X Money record/);
+  assert.match(stories, /Madam C\. J\. Walker/);
+  assert.doesNotMatch(stories, /Colton Hogan|GGM/);
+});
+
+test("ledger migrations are not an Ashcombe or shared-headquarters schema", () => {
+  const names = [
+    "migrations/001_avcu_payment_control_plane.sql",
+    "migrations/011_vantoris_approved_journal_posting.sql",
+    "migrations/024_vantoris_transfer_journal_visibility.sql",
+  ];
+  for (const name of names) {
+    const sql = read(name);
+    assert.doesNotMatch(sql, /ashcombe|headquarters|vantoris_private_institution/i);
+  }
+});
